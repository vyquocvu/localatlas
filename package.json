{
  "name": "localatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "localatlas": "./dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build:ui && tsc -p tsconfig.build.json",
    "build:ui": "vite build",
    "predev": "npm run build:ui",
    "dev": "tsx watch src/cli.ts serve",
    "prestart": "npm run build:ui",
    "start": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "htm": "^3.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.4"
  }
}
